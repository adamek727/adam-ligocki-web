---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { allLangs, useTranslations, type Lang } from '../../i18n/utils';
import { getProjects, entrySlug, projectMeta } from '../../lib/content';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const projects = await getProjects(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PageLayout title={t('page.projects.title')} container="wide">
  {projects.length === 0 ? (
    <p class="muted">{t('page.projects.empty')}</p>
  ) : (
    <div class="grid grid--cards">
      {projects.map((p) => (
        <ProjectCard
          title={p.data.title}
          description={p.data.description}
          href={`${base}/${lang}/projects/${entrySlug(p.id)}`}
          meta={projectMeta(p)}
          outcome={p.data.outcome}
          tags={p.data.tags}
        />
      ))}
    </div>
  )}
</PageLayout>
