---
import PageLayout from '../../../layouts/PageLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { allLangs, useTranslations, type Lang } from '../../../i18n/utils';
import { getBlogPosts, getAllTags, entrySlug } from '../../../lib/content';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getBlogPosts(lang);
const tags = await getAllTags(lang);

const tagHref = (tag: string) =>
  `${base}/${lang}/blog/tags/${encodeURIComponent(tag.toLowerCase())}`;
const postHref = (slug: string) => `${base}/${lang}/blog/${slug}`;
---

<PageLayout title={t('page.blog.title')} container="narrow">
  {tags.length > 0 && (
    <p class="cluster" style="gap: var(--sp-2); margin-bottom: var(--sp-6);">
      <span class="subtle" style="font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.05em; margin-right: var(--sp-2);">
        {t('page.blog.tags')}:
      </span>
      {tags.map((tag) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
    </p>
  )}

  {posts.length === 0 ? (
    <p class="muted">{t('page.blog.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <PostCard
            title={post.data.title}
            href={postHref(entrySlug(post.id))}
            date={post.data.pubDate}
            description={post.data.description}
            tags={post.data.tags}
            lang={lang}
          />
        </li>
      ))}
    </ul>
  )}
</PageLayout>
