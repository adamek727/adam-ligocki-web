---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLang } from '../i18n/utils';

const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${defaultLang}/`;
---

<BaseLayout title="404">
  <section class="container container--narrow section">
    <p class="hero__eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="muted">The page you are looking for does not exist.</p>
    <p style="margin-top: var(--sp-5);">
      <a href={home}>← Back home</a>
    </p>
  </section>
</BaseLayout>
