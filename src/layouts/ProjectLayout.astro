---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  client?: string;
  role?: string;
  period?: string;
  outcome?: string;
  stack?: string[];
  cover?: ImageMetadata;
  tags?: string[];
  repo?: string;
  link?: string;
}

const {
  title,
  description,
  client,
  role,
  period,
  outcome,
  stack = [],
  cover,
  tags = [],
  repo,
  link,
} = Astro.props;

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectsHref = `${base}/${lang}/projects`;

const facts = [
  { label: t('project.client'), value: client },
  { label: t('project.role'), value: role },
  { label: t('project.period'), value: period },
  { label: t('project.stack'), value: stack.length > 0 ? stack.join(' · ') : undefined },
].filter((f) => f.value);
---

<BaseLayout title={title} description={description}>
  <article class="container container--narrow section">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="muted" style="font-size: var(--fs-md);">{description}</p>
    </header>

    {cover && (
      <Image src={cover} alt={title} class="project-cover" widths={[640, 960, 1280]} />
    )}

    {facts.length > 0 && (
      <dl class="fact-list">
        {facts.map((fact) => (
          <div class="fact-list__row">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {outcome && (
      <p class="callout">
        <strong>{t('project.outcome')}:</strong> {outcome}
      </p>
    )}

    <div class="prose stack">
      <slot />
    </div>

    {(repo || link) && (
      <p class="cluster" style="margin-top: var(--sp-6); gap: var(--sp-4);">
        {repo && <a href={repo}>{t('project.repo')} →</a>}
        {link && <a href={link}>{t('project.link')} →</a>}
      </p>
    )}

    {tags.length > 0 && (
      <p class="cluster" style="margin-top: var(--sp-6); gap: var(--sp-2);">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </p>
    )}

    <p style="margin-top: var(--sp-7);">
      <a href={projectsHref}>{t('project.back')}</a>
    </p>
  </article>
</BaseLayout>
