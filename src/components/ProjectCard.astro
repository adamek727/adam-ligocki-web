---
interface Props {
  title: string;
  description: string;
  href?: string;
  meta?: string;
  outcome?: string;
  tags?: string[];
}

const { title, description, href, meta, outcome, tags = [] } = Astro.props;
---

<article class="card">
  <h3 class="card__title">
    {href ? <a href={href}>{title}</a> : title}
  </h3>
  {meta && <p class="card__meta">{meta}</p>}
  <p class="card__body">{description}</p>
  {outcome && <p class="card__outcome">{outcome}</p>}
  {tags.length > 0 && (
    <p class="cluster" style="gap: var(--sp-2);">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </p>
  )}
</article>
