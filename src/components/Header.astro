---
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  langAltPath?: string;
}

const { langAltPath } = Astro.props;

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/${lang}`;

// The site is one page plus the blog. The first three entries are blocks of
// the home page, written as absolute URLs so they also work from a blog post.
const items = [
  { href: `${home}/#robotics`, label: t('nav.services') },
  { href: `${home}/#work`,     label: t('nav.work') },
  { href: `${home}/#contact`,  label: t('nav.contact') },
  { href: `${home}/blog`,      label: t('nav.blog'), route: true },
];

const here = Astro.url.pathname.replace(/\/$/, '');
const onBlog = here === `${home}/blog` || here.startsWith(`${home}/blog/`);
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="site-brand" href={`${home}/`}>{t('site.title')}</a>

    <nav class="site-nav" aria-label="Primary">
      {items.map((item) => (
        <a href={item.href} aria-current={item.route && onBlog ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="cluster" style="gap: var(--sp-3);">
      <LanguageSwitcher altPath={langAltPath} />
      <ThemeToggle />
    </div>
  </div>
</header>
